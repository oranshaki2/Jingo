Content-Type: application/json

{
  "level": 1
}

###

### 3. עדכון ז'אנרים
PATCH http://localhost:3000/api/users/68f24401e72000776cf47a74/genres
Content-Type: application/json

{
  "genres": ["jazz", "electronic"]
}

###

### 4. עדכון רשימת מילים נכונות וטעויות
PATCH http://localhost:3000/api/users/6880f447647cf2a21f291ee4/history
Content-Type: application/json

{
  "correctWords": ["dog", "cat", "sky"],
  "mistakenWords": ["apple", "cat"]
}


### Get user details by username
PATCH http://localhost:3000/api/users/68f22ba7187347a8f2bdd95f/history
Content-Type: application/json

{
  "correctWords": ["heels","skirts","sneakers"],
  "mistakenWords": ["jeans"]
}

### Get user details by ID
POST http://localhost:3000/api/recommendations/only-new
Content-Type: application/json

{
  "user": {
    "wordHistory": ["jeans", "heels", "skirts", "sneakers"],
    "genre": ["rock", "pop"],
    "level": 1
  },
  "category": "Clothing"
}

